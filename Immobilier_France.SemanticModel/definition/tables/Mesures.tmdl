	measure 'Evolution Prix m2 %' = VAR PrixAnneePrecedente = CALCULATE([Prix Moyen m2], SAMEPERIODLASTYEAR('Dim Date'[Date])) RETURN DIVIDE([Prix Moyen m2] - PrixAnneePrecedente, PrixAnneePrecedente, 0)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 1876e9ae-0116-47c7-8c1d-6b895ef2b7fc

	measure 'Moyenne Taux Interet %' =
			
