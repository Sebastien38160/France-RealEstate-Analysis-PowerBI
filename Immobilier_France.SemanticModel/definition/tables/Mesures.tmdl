		lineageTag: cbaeab0b-d50b-4812-b744-2a426471b675

	measure 'CA Total' = SUM(Fait_Ventes[Prix])
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 9e30e8db-95e3-42f4-adc4-d5d72bc34bac

	measure 'Couleur Dynamique' =
			
			VAR mesure = SELECTEDVALUE('Mesure sélectionner'[Mesure sélectionner Commande])
			RETURN
			SWITCH(
			    mesure,
			    0, "#56C960",
			    1, "#329D9C",
			    2, "#9FD3C7"
			)
		lineageTag: 6721293e-e9c8-47da-9f70-a89063e02f76

	measure 'Liste des valeurs de Région' =
			
			VAR __DISTINCT_VALUES_COUNT = DISTINCTCOUNT('Dim Géographie'[Région])
			VAR __MAX_VALUES_TO_SHOW = 3
			RETURN
				"Analyse des ventes pour la région " & IF(
					__DISTINCT_VALUES_COUNT > __MAX_VALUES_TO_SHOW,
					CONCATENATE(
						CONCATENATEX(
							TOPN(
								__MAX_VALUES_TO_SHOW,
								VALUES('Dim Géographie'[Région]),
								'Dim Géographie'[Région],
								ASC
							),
							'Dim Géographie'[Région],
							", ",
							'Dim Géographie'[Région],
							ASC
						),
						",  etc."
					),
					CONCATENATEX(
						VALUES('Dim Géographie'[Région]),
						'Dim Géographie'[Région],
						", ",
						'Dim Géographie'[Région],
						ASC
					)
				)
		lineageTag: c5cedb34-4e68-4980-a91a-583fa6c07a8e

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "ConcatenateValues"
				}

		changedProperty = FormatString

	measure 'Liste des valeurs de Nom Département' =
			
			VAR __DISTINCT_VALUES_COUNT = DISTINCTCOUNT('Dim Géographie'[Département])
			VAR __MAX_VALUES_TO_SHOW = 3
			RETURN
				IF(
					__DISTINCT_VALUES_COUNT > __MAX_VALUES_TO_SHOW,
					CONCATENATE(
						CONCATENATEX(
							TOPN(
								__MAX_VALUES_TO_SHOW,
								VALUES('Dim Géographie'[Département]),
								'Dim Géographie'[Département],
								ASC
							),
							'Dim Géographie'[Département],
							", ",
							'Dim Géographie'[Département],
							ASC
						),
						",  etc."
					),
					CONCATENATEX(
						VALUES('Dim Géographie'[Département]),
						'Dim Géographie'[Département],
						", ",
						'Dim Géographie'[Département],
						ASC
					)
				)
		lineageTag: 51eacfbe-d19a-4555-8de7-f29671d26e26

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "ConcatenateValues"
				}

		changedProperty = FormatString

	measure 'Titre Dynamique Complet' =
			
			VAR __MAX_VALUES_TO_SHOW = 3
			
			-- Logique pour les Régions
			VAR __DISTINCT_REGIONS = DISTINCTCOUNT('Dim Géographie'[Région])
			VAR __REGION_TEXT = IF(__DISTINCT_REGIONS > __MAX_VALUES_TO_SHOW,
			    CONCATENATEX(TOPN(__MAX_VALUES_TO_SHOW, VALUES('Dim Géographie'[Région])), 'Dim Géographie'[Région], ", ") & ", etc.",
			    CONCATENATEX(VALUES('Dim Géographie'[Région]), 'Dim Géographie'[Région], ", ")
			)
			
			-- Logique pour les Départements
			VAR __DISTINCT_DEPT = DISTINCTCOUNT('Dim Géographie'[Département])
			VAR __DEPT_TEXT = IF(__DISTINCT_DEPT > __MAX_VALUES_TO_SHOW,
			    CONCATENATEX(TOPN(__MAX_VALUES_TO_SHOW, VALUES('Dim Géographie'[Département])), 'Dim Géographie'[Département], ", ") & ", etc.",
			    CONCATENATEX(VALUES('Dim Géographie'[Département]), 'Dim Géographie'[Département], ", ")
			)
			
			RETURN
			"Analyse pour la région : " & __REGION_TEXT & " | Département(s) : " & __DEPT_TEXT
		lineageTag: bee53d2d-f6f0-4e27-aded-0ccd6a34c094

	/// Couleur conditionnelle pour le graphique barres divergentes : vert si hausse, rouge si baisse
	measure 'Couleur Evolution Prix m2' = IF([Evolution Prix m2 %] >= 0, "#1D9E75", "#E24B4A")
		lineageTag: e9c1c14b-0f95-4183-8689-999ef00c4569

	measure 'Surface Habitable' = SUM(Fait_Ventes[Surface Habitable])
		formatString: #,0
		lineageTag: 6eb84539-f521-4b98-ac58-b490a0a1f805

	partition Mesures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Colonne 1" = _t]),
				    #"Type modifié" = Table.TransformColumnTypes(Source,{{"Colonne 1", type text}}),
				    #"Colonnes supprimées" = Table.RemoveColumns(#"Type modifié",{"Colonne 1"})
				in
				    #"Colonnes supprimées"

	annotation PBI_ResultType = Table

