	measure 'Moyenne Taux Endettement %' = ```
			
			CALCULATE(
			    AVERAGE('Fait taux_endettement'[taux_endettement]), 
			    ALL('Dim Géographie')
			)
			```
		formatString: 0.00\ "%"
		lineageTag: 663b29ca-571d-4544-943f-2e904c29444c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

